{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookstore-sonnet",
  "main": "src/main.ts",
  "compatibility_date": "2026-09-01",
  // Writes src/routes.gen.ts before wrangler dev and wrangler deploy, and again while dev runs when src/routes changes
  "build": { "command": "pnpm hnk prepare", "watch_dir": "src/routes" },
  "vars": {
    "BETTER_AUTH_SECRET": "local-dev-secret-change-me-in-production-0123456789",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore-sonnet",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
}
